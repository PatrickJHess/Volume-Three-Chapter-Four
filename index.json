e":18,"column":1},"end":{"line":18,"column":1}},"key":"uIYCLoiFWK"}],"key":"NLUpbNJutH"}],"key":"Hvdd0UM3mE"}],"key":"MFKKawumpB"}],"key":"vKIntEBBEF"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"This chapter introduces and estimates the Nelson-Siegel model. 🚀 Future volumes will utilize this framework (along with the Svensson extension, where appropriate) to accurately price financial instruments. 🔮💼","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"nquEKT8RIR"}],"key":"FrvYD8vLqR"}],"key":"D1gPxtw2UX"}],"key":"BXjRrfTLl7"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"🪐 Working with Jupyter Books","short_title":"Interacting With Jupyter Books","url":"/interacting-with-jupyter-books","group":"Getting Started"}}},"domain":"http://localhost:3000"}